# Diretorios de dependencias (muito pesados para o Git)
node_modules/
backend/node_modules/

# Arquivos de configuracao local e credenciais (SEGURANCA CRITICA!)
.env
backend/.env

# Uploads locais (nao devem ir para o Git)
backend/uploads/*
